        "asse em forno preaquecido até ficar macio",
        "deixe esfriar antes de porcionar"
      ]
    },
    "grilling_baking": {
      "label": "Grelhado ou assado",
      "steps": [
        "tempere a gosto",
        "grelhe ou asse até ficar totalmente cozido",
        "deixe esfriar antes de porcionar"
      ]
    },
    "steaming": {
      "label": "Cozido no vapor",
      "steps": [
        "lave e corte em pedaços",
        "cozinhe no vapor até ficar macio, mas ainda firme",
        "deixe esfriar antes de porcionar"
      ]
    },
    "sauté": {
      "label": "Refogado",
      "steps": [
        "corte em pedaços",
        "refogue em frigideira com um fio de azeite até ficar macio",
        "deixe esfriar antes de porcionar"
      ]
    },
    "microwave": {
      "label": "Micro-ondas",
      "steps": [
        "coloque em um recipiente próprio para micro-ondas",
        "cozinhe até ficar macio",
        "deixe esfriar antes de porcionar"
      ]
    },
    "water_absorption": {
      "label": "Cozido com absorção de água",
