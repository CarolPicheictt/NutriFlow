        "escorra e deixe esfriar antes de porcionar"
      ]
    },
    "boiling_braising": {
      "label": "Cozido na panela com água",
      "steps": [
        "tempere a gosto e coloque em uma panela com água",
        "deixe ferver até ficar totalmente cozido",
        "retire da água e deixe esfriar antes de porcionar"
      ]
    },
    "braising": {
      "label": "Cozido em panela tampada",
      "steps": [
