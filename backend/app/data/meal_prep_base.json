        "cozinhe em panela tampada com um pouco de água até ficar macio",
        "deixe esfriar antes de porcionar"
      ]
    },
    "grilling": {
      "label": "Grelhado",
      "steps": [
        "tempere a gosto",
        "grelhe em frigideira ou chapa aquecida até dourar e ficar totalmente cozido",
        "deixe esfriar antes de porcionar"
      ]
    },
    "broiling_grilling": {
      "label": "Grelhado",
      "steps": [
        "tempere a gosto",
        "grelhe em frigideira ou chapa aquecida até dourar e ficar totalmente cozido",
        "deixe esfriar antes de porcionar"
      ]
    },
    "roasting": {
      "label": "Assado",
      "steps": [
        "tempere a gosto",
        "asse em forno preaquecido até ficar totalmente cozido",
        "deixe esfriar antes de porcionar"
      ]
    },
    "baking": {
      "label": "Assado",
      "steps": [
